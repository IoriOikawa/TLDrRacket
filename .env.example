# Copy to .env locally. Use /etc/tldrracket.env on the VPS.
# Existing environment variables take precedence over the local .env file.
GOOGLE_API_KEY=replace-with-your-key
CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Relative paths resolve against the process working directory.
DATA_PATH=./data
CHROMA_PATH=./chroma
# Provisional cosine distance cutoff: LOWER is more similar. Calibrate on your corpus.
MAX_DISTANCE=0.35
CANDIDATE_COUNT=20
PROVIDER_TIMEOUT=30
MAX_MESSAGE_LENGTH=2000
